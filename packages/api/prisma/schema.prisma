// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BirdColor {
  BLACK
  WHITE
  BROWN
  GRAY
  RED
  YELLOW
  BLUE
  GREEN
  ORANGE
  PINK
  PURPLE
}

enum TaxonSource {
  INATURALIST
  BIRDNET
  PLANT_ID
  CUSTOM_UPLOAD
}

enum ContentType {
  BIRD
  PLANT
}

enum MediaType {
  PHOTO
  AUDIO
  VIDEO
}

model BirdOrder {
  id            Int      @id @default(autoincrement())
  nameLa        String   @map("name_la")
  descriptionEn String?  @map("description_en")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @default(now()) @map("updated_at")

  birds           Bird[] // A single order describes many birds
  BirdOrderImages BirdOrderImages[]
}

model Bird {
  id               Int                @id @default(autoincrement())
  nameLocal        String             @map("name_local")
  nameEn           String             @map("name_en")
  nameLa           String             @unique @map("name_la")
  nameMeaningEn    String?            @map("name_meaning_en")
  colors           BirdColor[]
  media            Media[]
  birdTaxonMapping BirdTaxonMapping[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @default(now()) @map("updated_at")

  orderId Int?       @map("order_id")
  order   BirdOrder? @relation(fields: [orderId], references: [id])
}

model TaxonMapping {
  id          Int         @id @default(autoincrement())
  source      TaxonSource
  externalId  String      @map("external_id") // from iNaturalist or BirdNet
  contentType ContentType @map("content_type") // BIRD or PLANT
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @default(now()) @map("updated_at")

  birdMapping BirdTaxonMapping?
}

model BirdTaxonMapping {
  id Int @id @default(autoincrement())

  taxonMapId Int          @unique @map("taxon_map_id")
  taxonMap   TaxonMapping @relation(fields: [taxonMapId], references: [id])

  birdId Int  @unique @map("bird_id")
  bird   Bird @relation(fields: [birdId], references: [id])
}

model BirdOrderImages {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @default(now()) @map("updated_at")

  birdOrderId Int       @map("bird_order_id")
  birdOrder   BirdOrder @relation(fields: [birdOrderId], references: [id])

  mediaId Int   @map("media_id")
  media   Media @relation(fields: [mediaId], references: [id])

  @@unique([birdOrderId, mediaId])
}

model Media {
  id        Int       @id @default(autoincrement())
  url       String
  caption   String?
  source    String?
  type      MediaType
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @default(now()) @map("updated_at")

  birdId      Int? @map("bird_id")
  birdOrderId Int? @map("bird_order_id")

  bird            Bird?             @relation(fields: [birdId], references: [id])
  BirdOrderImages BirdOrderImages[]
}
